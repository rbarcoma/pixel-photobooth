{
  "name": "pixel-booth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "prebuild": "node scripts/prepare-assets.mjs",
    "postbuild": "node scripts/check-font.mjs",
    "check:font": "node scripts/check-font.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "data:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate-local.ts",
    "moderate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/moderate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:server": "node --import tsx tests/preview-server.ts",
    "smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "express": "^4.22.3",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.1",
    "@vercel/routing-utils": "^6.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.6"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}
