# Server-only values. Never prefix these with VITE_ or commit real credentials.
# Copy to .env.local for development; set these in Vercel for each environment.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
SESSION_SECRET=
ADMIN_API_TOKEN=
CRON_SECRET=
APP_ORIGIN=http://localhost:5173
FEEDBACK_MODERATION=manual
# Existing optional local API port:
PORT=3001
# Optional local proxy override, used only by Vite's development server:
# API_PROXY_TARGET=http://localhost:3001
# Optional, for Git builds that do not contain the existing licensed font:
# Only after obtaining permission for public webfont hosting. Choose ONE source.
# ARCADE_FONT_BASE64=base64-encoded-existing-ttf
# ARCADE_FONT_URL=https://your-licensed-asset-host/arcadeclassic.ttf
# Optional, for authorized smoke tests against a protected Vercel preview:
# VERCEL_AUTOMATION_BYPASS_SECRET=
